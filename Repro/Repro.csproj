<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Features>$(Features);runtime-async=on</Features>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Override with -p:HarmonyXProject=/path/to/Harmony/Harmony.csproj -->
    <HarmonyXProject Condition="'$(HarmonyXProject)' == ''">../../HarmonyX/Harmony/Harmony.csproj</HarmonyXProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TargetLib/TargetLib.csproj" />
    <ProjectReference Include="$(HarmonyXProject)" />
    <PackageReference Include="MonoDetour" Version="0.7.18" />
    <PackageReference Include="MonoDetour.Interop.HarmonyX" Version="0.7.18" />
    <!-- Satisfy MonoDetour.Interop.HarmonyX's dependency without copying its 0Harmony. -->
    <PackageReference Include="HarmonyX" Version="2.16.1" ExcludeAssets="all" />
  </ItemGroup>
</Project>
